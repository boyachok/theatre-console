#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")"
CLI='/Applications/Arduino IDE.app/Contents/Resources/app/lib/backend/resources/arduino-cli'
ESPROOT="$HOME/Library/Arduino15/packages/esp32"
FQBN='esp32:esp32:esp32s3:USBMode=hwcdc,CDCOnBoot=cdc,FlashSize=16M,FlashMode=dio,PSRAM=opi,PartitionScheme=custom'
usage(){ echo 'Usage: ./deploy {master|slave|remote|helmet} [USB_PORT] | ./deploy build {master|slave|remote|helmet} | ./deploy ota {master|slave} IP'; }
ACTION=usb
case "${1:-}" in
  build|ota) ACTION="$1"; shift ;;
esac
ROLE="${1:-}"
case "$ROLE" in master) MASTER=1 ;; slave|remote|helmet) MASTER=0 ;; *) usage;exit 1;; esac
shift
PROFILE="${PROFILE:-console}"
case "$PROFILE" in console|control|wifi04|espnow|radio) ;; *) echo 'PROFILE must be console, control, wifi04, espnow or radio';exit 1;;esac
SKETCH="$PROFILE"
if [[ "$ROLE" == remote || "$ROLE" == helmet ]]; then
  [[ "$PROFILE" == console ]] || { echo "$ROLE is supported only by PROFILE=console";exit 1; }
  [[ "$ACTION" != ota ]] || { echo "$ROLE has no HTTP/OTA server: use USB";exit 1; }
  SKETCH="$ROLE"
fi
FLAGS="-DRADIO_MASTER=$MASTER"
if [[ "$ROLE" == remote || "$ROLE" == helmet ]]; then FLAGS="$FLAGS -I$PWD/console";fi
if [[ "$ROLE" == remote ]]; then FLAGS="$FLAGS -DRADIO_REMOTE=1";fi
if [[ "$PROFILE" == console || "$PROFILE" == control || "$PROFILE" == wifi04 ]]; then
  OUT="$PWD/build/$PROFILE-$ROLE-wifi"
  LINK='Wi-Fi LAN'
else
  CHANNEL="${RADIO_CHANNEL:-6}"
  if ! [[ "$CHANNEL" =~ ^([1-9]|10|11)$ ]]; then echo 'RADIO_CHANNEL must be 1..11';exit 1;fi
  FLAGS="$FLAGS -DRADIO_CHANNEL=$CHANNEL"
  OUT="$PWD/build/$PROFILE-$ROLE-ch$CHANNEL"
  LINK="ESP-NOW channel $CHANNEL"
fi
BIN="$SKETCH.ino"
if [[ "$PROFILE" == console ]]; then
  python3 tools/release.py --check
  if [[ "$ROLE" != remote && "$ROLE" != helmet ]]; then
    (cd score-ui && VITE_CONSOLE_BACKEND=1 npm run build)
    python3 tools/embed_console.py
  fi
fi
"$CLI" compile --clean --fqbn "$FQBN" --build-property "compiler.cpp.extra_flags=$FLAGS" --output-dir "$OUT" "$SKETCH"
printf '\nApplication binary: %s/%s.bin\n' "$OUT" "$BIN"
check_mac(){
  local mac expected
  mac="$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"
  expected="$(printf '%s' "${EXPECTED_MAC:-}" | tr '[:lower:]' '[:upper:]')"
  if [[ "$ROLE" == master && -z "$expected" ]]; then expected='A0:85:E3:E2:BC:D4';fi
  if [[ "$ROLE" != remote && "$mac" == '30:30:F9:1B:FD:6C' ]]; then echo 'Refusing to replace the known physical remote with another role.' >&2;exit 1;fi
  if [[ -n "$expected" && "$mac" != "$expected" ]]; then echo "Refusing to flash: MAC $mac != expected $expected" >&2;exit 1;fi
  if [[ "$ROLE" != master && "$mac" == 'A0:85:E3:E2:BC:D4' ]]; then echo 'Refusing to replace the known master with slave/remote/helmet firmware.' >&2;exit 1;fi
}
case "$ACTION" in
 build) exit 0 ;;
 ota)
   IP="${1:?Specify the device IP}"
   STATUS="$(curl --noproxy '*' --fail --silent --show-error --connect-timeout 3 --max-time 8 "http://$IP/api/status")"
   IDENTITY="$(printf '%s' "$STATUS" | python3 -c 'import sys,json;d=json.load(sys.stdin);assert d["role"]==sys.argv[1], "Wrong target role";print(d["mac"].upper(),d["token"])' "$ROLE")"
   read -r MAC TOKEN <<< "$IDENTITY";check_mac "$MAC"
   curl --noproxy '*' --fail --show-error --connect-timeout 3 --max-time 120 -F "firmware=@$OUT/$BIN.bin" "http://$IP/update?token=$TOKEN&target=$MAC"
   EXPECTED_VERSION='';if [[ "$PROFILE" == console ]]; then EXPECTED_VERSION="$(python3 -c 'import json;print(json.load(open("version.json"))["version"])')";fi
   for attempt in {1..15}; do
     sleep 1
     if curl --noproxy '*' --fail --silent --connect-timeout 2 --max-time 3 "http://$IP/api/status" | python3 -c 'import sys,json;d=json.load(sys.stdin);assert d["mac"].upper()==sys.argv[1] and d["role"]==sys.argv[2] and (not sys.argv[3] or d["version"]==sys.argv[3])' "$MAC" "$ROLE" "$EXPECTED_VERSION" 2>/dev/null; then echo "Verified $ROLE $MAC $EXPECTED_VERSION after reboot";exit 0;fi
   done
   echo 'Upload returned, but reboot/version could not be verified. Check DHCP/Serial; not declaring success.' >&2;exit 1 ;;
esac
PORT="${1:-}"
if [[ -z "$PORT" ]]; then
  shopt -s nullglob
  PORTS=(/dev/cu.usbmodem* /dev/cu.usbserial* /dev/cu.wchusbserial*)
  if [[ ${#PORTS[@]} -ne 1 ]]; then echo 'Connect exactly one board or specify USB_PORT explicitly.';printf '%s\n' "${PORTS[@]}";exit 1;fi
  PORT="${PORTS[0]}"
fi
INFO="$("$ESPROOT/tools/esptool_py/5.3.1/esptool" --chip esp32s3 --port "$PORT" --baud 115200 --before usb-reset --after no-reset read-mac)"
printf '%s\n' "$INFO"
MAC="$(printf '%s' "$INFO" | python3 -c 'import sys,re;v=set(s.upper() for s in re.findall(r"(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}",sys.stdin.read()));assert len(v)==1,"Cannot identify one target MAC";print(v.pop())')"
check_mac "$MAC"
printf '\nDeploying %s %s to %s (%s). This replaces the current application.\n' "$PROFILE" "$ROLE" "$PORT" "$LINK"
"$ESPROOT/tools/esptool_py/5.3.1/esptool" --chip esp32s3 --port "$PORT" --baud 115200 \
  --before no-reset --after watchdog-reset write-flash --flash-mode dio --flash-freq 80m --flash-size 16MB \
  0x0 "$OUT/$BIN.bootloader.bin" 0x8000 "$OUT/$BIN.partitions.bin" \
  0xe000 "$ESPROOT/hardware/esp32/3.3.11/tools/partitions/boot_app0.bin" 0x10000 "$OUT/$BIN.bin"
echo 'Deployment complete. USB command i prints role and network details.'
