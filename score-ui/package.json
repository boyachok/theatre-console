{
  "name": "theatre-score-ui",
  "private": true,
  "version": "0.8.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "prebuild": "python3 ../tools/release.py --check",
    "pretest": "python3 ../tools/release.py --check",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "node --test src/domain/*.test.ts",
    "test:ui": "node tests/ui.mjs",
    "test:esp-ui": "node tests/esp-ui.mjs",
    "format": "prettier --write src tests vite.config.ts"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.0.0"
  }
}
